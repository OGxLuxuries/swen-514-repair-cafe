# Terraform downloads and local state can contain sensitive values.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Keep local deployment values and credentials out of Git.
*.tfvars
*.tfvars.json
.env
.env.*
!.env.example

# Commit .terraform.lock.hcl once terraform init generates it.
.DS_Store

# Shared bucket policy contains participant account associations.
/terraform/shared-state-bucket-policy.json
