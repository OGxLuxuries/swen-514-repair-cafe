aws_region   = "us-east-1"
project_name = "repair-cafe"
environment  = "dev"

tags = {
  Course = "SWEN-514"
  Team   = "Group-2"
}

# Required before planning: build the Python 3.13 / Linux x86_64 deployment ZIP
# with app.py and dependencies at its root, then set its actual location.
# lambda_zip_path = "../backend/lambda.zip"
lambda_handler = "app.lambda_handler"

# Required: use the US Sonnet 5.5 inference-profile ARN for your AWS account.
# Replace <account-id> with the deploying account's 12-digit ID.
# The Terraform deployment identity needs bedrock:GetInferenceProfile, and
# each account must meet Anthropic's model-access requirements.
# bedrock_model_arn = "arn:aws:bedrock:us-east-1:<account-id>:inference-profile/us.anthropic.claude-sonnet-5-5"
